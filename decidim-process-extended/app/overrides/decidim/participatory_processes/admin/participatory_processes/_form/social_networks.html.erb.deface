<!-- insert_after "div#accordion-related_processes"
     original '1725821960cf80ab04c0a4705391aa14706e1ebc'
-->
<%# Participa: social networks of the participatory processes, after the related processes %>
<div class="card" data-controller="accordion" id="accordion-social">
  <div class="card-divider">
    <button class="card-divider-button" data-open="true" data-controls="panel-social" type="button">
      <%= icon "arrow-right-s-line" %>
      <h2 class="card-title" id="social">
        <%= t("social", scope: "decidim.participatory_processes.admin.participatory_processes.form") %>
      </h2>
    </button>
  </div>
  <div id="panel-social" class="card-section">
    <div class="row column">
      <%= form.social_field :text_field,
                            :social_handlers,
                            Decidim::Organization::SOCIAL_HANDLERS,
                            label: t("social_networks",
                                     scope: "decidim.participatory_processes.admin.participatory_processes.form") %>
    </div>
  </div>
</div>
