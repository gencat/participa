<div class="form__wrapper">
  <div class="card pt-4">
    <div class="card-section">
      <div class="row column">
        <%= form.translated :editor, :body, lines: 30, label: t("models.components.body", scope: "decidim.pages.admin") %>
      </div>

      <%#= Participa gencat override %>
      <div class="row column">
        <%= form.attachment :documents,
                            multiple: true,
                            label: t("decidim.pages.form.add_attachments"),
                            button_label: t("decidim.pages.form.add_attachments"),
                            button_class: "button button__sm button__transparent-secondary mt-2 md:w-auto w-full",
                            button_edit_label: t("decidim.pages.form.edit_attachments"),
                            help_i18n_scope: "decidim.forms.file_help.file",
                            help_text: t("decidim.pages.form.attachment_legend") %>
      </div>
      <%#= Participa gencat override %>
    </div>
  </div>
</div>
